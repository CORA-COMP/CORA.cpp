{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "cpp",
      "displayName": "C++ only (Eigen)",
      "inherits": "base",
      "cacheVariables": { "CORACPP_TORCH": "OFF", "CORACPP_PYTHON": "OFF" }
    },
    {
      "name": "torch",
      "displayName": "C++ with libtorch (downloaded, no Python)",
      "inherits": "base",
      "cacheVariables": { "CORACPP_TORCH": "DOWNLOAD", "CORACPP_PYTHON": "OFF" }
    },
    {
      "name": "python",
      "displayName": "C++ and the Python package on numpy (a .venv is created)",
      "inherits": "base",
      "cacheVariables": {
        "CORACPP_TORCH": "OFF",
        "CORACPP_PYTHON": "ON",
        "CORACPP_VENV": "ON",
        "CORACPP_VENV_REQUIREMENTS": "requirements-python.txt"
      }
    },
    {
      "name": "python-torch",
      "displayName": "C++ and the Python package with torch (a .venv is created)",
      "inherits": "base",
      "cacheVariables": {
        "CORACPP_TORCH": "ON",
        "CORACPP_PYTHON": "ON",
        "CORACPP_VENV": "ON",
        "CORACPP_VENV_REQUIREMENTS": "requirements-python-torch.txt"
      }
    },
    {
      "name": "torch-cuda",
      "displayName": "C++ with a CUDA libtorch (downloaded, no Python needed)",
      "inherits": "torch",
      "cacheVariables": { "CORACPP_TORCH_VARIANT": "cu126" }
    },
    {
      "name": "python-torch-cuda",
      "displayName": "C++ and the Python package with CUDA torch (a .venv is created)",
      "inherits": "python-torch",
      "cacheVariables": { "CORACPP_VENV_TORCH_INDEX": "https://download.pytorch.org/whl/cu126" }
    }
  ],
  "buildPresets": [
    { "name": "base", "hidden": true, "configuration": "Release", "jobs": 4 },
    { "name": "cpp", "configurePreset": "cpp", "inherits": "base" },
    { "name": "torch", "configurePreset": "torch", "inherits": "base" },
    { "name": "python", "configurePreset": "python", "inherits": "base" },
    { "name": "python-torch", "configurePreset": "python-torch", "inherits": "base" },
    { "name": "torch-cuda", "configurePreset": "torch-cuda", "inherits": "base" },
    { "name": "python-torch-cuda", "configurePreset": "python-torch-cuda", "inherits": "base" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    { "name": "cpp", "configurePreset": "cpp", "inherits": "base" },
    { "name": "torch", "configurePreset": "torch", "inherits": "base" },
    { "name": "python", "configurePreset": "python", "inherits": "base" },
    { "name": "python-torch", "configurePreset": "python-torch", "inherits": "base" },
    { "name": "torch-cuda", "configurePreset": "torch-cuda", "inherits": "base" },
    { "name": "python-torch-cuda", "configurePreset": "python-torch-cuda", "inherits": "base" }
  ],
  "workflowPresets": [
    {
      "name": "cpp",
      "steps": [
        { "type": "configure", "name": "cpp" },
        { "type": "build", "name": "cpp" },
        { "type": "test", "name": "cpp" }
      ]
    },
    {
      "name": "torch",
      "steps": [
        { "type": "configure", "name": "torch" },
        { "type": "build", "name": "torch" },
        { "type": "test", "name": "torch" }
      ]
    },
    {
      "name": "python",
      "steps": [
        { "type": "configure", "name": "python" },
        { "type": "build", "name": "python" },
        { "type": "test", "name": "python" }
      ]
    },
    {
      "name": "python-torch",
      "steps": [
        { "type": "configure", "name": "python-torch" },
        { "type": "build", "name": "python-torch" },
        { "type": "test", "name": "python-torch" }
      ]
    },
    {
      "name": "torch-cuda",
      "steps": [
        { "type": "configure", "name": "torch-cuda" },
        { "type": "build", "name": "torch-cuda" },
        { "type": "test", "name": "torch-cuda" }
      ]
    },
    {
      "name": "python-torch-cuda",
      "steps": [
        { "type": "configure", "name": "python-torch-cuda" },
        { "type": "build", "name": "python-torch-cuda" },
        { "type": "test", "name": "python-torch-cuda" }
      ]
    }
  ]
}
