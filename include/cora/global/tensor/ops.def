// ops - the table of Tensor operations: kind, differentiability and agreement with lean
//
// One row per operation: CORA_TENSOR_OP(name, kind, gradient, agreement, k, summary)
//   kind       core (every backend implements it), derived (a portable default made of core
//              operations, src/global/tensor/derived.cpp, which a backend may override) or fused
//              (a derived hot-spot primitive with one specification)
//   gradient   differentiable, piecewise (the gradient of the branch taken, as torch.sort) or
//              not_differentiable (on torch the result is detached, with a warning)
//   agreement  how the Eigen and torch results agree with the lean backend's (tests/global/tensor/
//              test_tensor_equivalence.cpp): exact (bit for bit), ulp (at most k ulp of the
//              result), sum (at most k*n*u times the same operation on |operands|, n its length),
//              norm (at most k*n*u times the largest entry, n the matrix size, well-conditioned)
// Read by tensor_ops() (C++ and Python), docs/tensor.md and the conventions test.

// Construction ------------------------------------------------------------------------------------
CORA_TENSOR_OP(like, core, not_differentiable, exact, 0, "host values as a tensor of the backend, device and dtype of another")
CORA_TENSOR_OP(full, core, not_differentiable, exact, 0, "a tensor of one value, like another")
CORA_TENSOR_OP(arange, core, not_differentiable, exact, 0, "0, 1, ..., n-1 as a 1-D tensor, like another")
CORA_TENSOR_OP(eye, derived, not_differentiable, exact, 0, "the identity (..., n, n), like another")
CORA_TENSOR_OP(to, core, differentiable, exact, 0, "the values on another device or in another dtype")
CORA_TENSOR_OP(data, core, not_differentiable, exact, 0, "the values on the host, row-major")
// Elementwise -------------------------------------------------------------------------------------
CORA_TENSOR_OP(add, core, differentiable, exact, 0, "a + b, broadcast")
CORA_TENSOR_OP(subtract, core, differentiable, exact, 0, "a - b, broadcast")
CORA_TENSOR_OP(multiply, core, differentiable, exact, 0, "a * b elementwise, broadcast")
CORA_TENSOR_OP(divide, core, differentiable, exact, 0, "a / b elementwise, broadcast")
CORA_TENSOR_OP(pow, core, differentiable, ulp, 2, "a ** b elementwise, broadcast")
CORA_TENSOR_OP(maximum, core, piecewise, exact, 0, "the larger of a and b, broadcast")
CORA_TENSOR_OP(minimum, core, piecewise, exact, 0, "the smaller of a and b, broadcast")
CORA_TENSOR_OP(remainder, core, piecewise, exact, 0, "fmod(a, b), plus b where their signs differ (MATLAB mod)")
CORA_TENSOR_OP(atan2, core, differentiable, ulp, 2, "the angle of (b, a), broadcast")
CORA_TENSOR_OP(equal, core, not_differentiable, exact, 0, "1 where a == b, else 0")
CORA_TENSOR_OP(not_equal, core, not_differentiable, exact, 0, "1 where a != b, else 0")
CORA_TENSOR_OP(less, core, not_differentiable, exact, 0, "1 where a < b, else 0")
CORA_TENSOR_OP(less_equal, core, not_differentiable, exact, 0, "1 where a <= b, else 0")
CORA_TENSOR_OP(greater, core, not_differentiable, exact, 0, "1 where a > b, else 0")
CORA_TENSOR_OP(greater_equal, core, not_differentiable, exact, 0, "1 where a >= b, else 0")
CORA_TENSOR_OP(negative, core, differentiable, exact, 0, "-x")
CORA_TENSOR_OP(abs, core, piecewise, exact, 0, "|x|")
CORA_TENSOR_OP(sign, core, piecewise, exact, 0, "-1, 0 or 1")
CORA_TENSOR_OP(floor, core, piecewise, exact, 0, "the largest integer <= x")
CORA_TENSOR_OP(ceil, core, piecewise, exact, 0, "the smallest integer >= x")
CORA_TENSOR_OP(round, core, piecewise, exact, 0, "the nearest integer, halves away from zero (MATLAB round), +0 for a zero")
CORA_TENSOR_OP(sqrt, core, differentiable, ulp, 1, "the square root (correctly rounded on the host; torch vectorized: 1 ulp)")
CORA_TENSOR_OP(exp, core, differentiable, ulp, 2, "e^x")
CORA_TENSOR_OP(log, core, differentiable, ulp, 2, "the natural logarithm")
CORA_TENSOR_OP(sin, core, differentiable, ulp, 2, "sine")
CORA_TENSOR_OP(cos, core, differentiable, ulp, 2, "cosine")
CORA_TENSOR_OP(tan, core, differentiable, ulp, 2, "tangent")
CORA_TENSOR_OP(asin, core, differentiable, ulp, 2, "arc sine")
CORA_TENSOR_OP(acos, core, differentiable, ulp, 2, "arc cosine")
CORA_TENSOR_OP(atan, core, differentiable, ulp, 2, "arc tangent")
CORA_TENSOR_OP(sinh, core, differentiable, ulp, 2, "hyperbolic sine")
CORA_TENSOR_OP(cosh, core, differentiable, ulp, 2, "hyperbolic cosine")
CORA_TENSOR_OP(tanh, core, differentiable, ulp, 2, "hyperbolic tangent")
CORA_TENSOR_OP(asinh, core, differentiable, ulp, 2, "inverse hyperbolic sine")
CORA_TENSOR_OP(acosh, core, differentiable, ulp, 2, "inverse hyperbolic cosine")
CORA_TENSOR_OP(atanh, core, differentiable, ulp, 2, "inverse hyperbolic tangent")
CORA_TENSOR_OP(isnan, core, not_differentiable, exact, 0, "1 where x is NaN, else 0")
CORA_TENSOR_OP(isinf, core, not_differentiable, exact, 0, "1 where x is infinite, else 0")
CORA_TENSOR_OP(isfinite, core, not_differentiable, exact, 0, "1 where x is finite, else 0")
CORA_TENSOR_OP(where, core, piecewise, exact, 0, "a where the condition is nonzero, else b, broadcast")
CORA_TENSOR_OP(square, derived, differentiable, exact, 0, "x * x")
CORA_TENSOR_OP(sigmoid, derived, differentiable, ulp, 4, "1 / (1 + e^-x)")
CORA_TENSOR_OP(clip, derived, piecewise, exact, 0, "x limited to [low, high]")
// Reductions --------------------------------------------------------------------------------------
CORA_TENSOR_OP(sum, core, differentiable, sum, 1, "the sum along an axis (lean: nested to the right from zero)")
CORA_TENSOR_OP(prod, core, differentiable, sum, 1, "the product along an axis")
CORA_TENSOR_OP(max, core, piecewise, exact, 0, "the largest entry along an axis")
CORA_TENSOR_OP(min, core, piecewise, exact, 0, "the smallest entry along an axis")
CORA_TENSOR_OP(argmax, core, not_differentiable, exact, 0, "the index of the first largest entry along an axis")
CORA_TENSOR_OP(argmin, core, not_differentiable, exact, 0, "the index of the first smallest entry along an axis")
CORA_TENSOR_OP(cumsum, core, differentiable, sum, 1, "the running sum along an axis")
CORA_TENSOR_OP(mean, derived, differentiable, sum, 1, "the mean along an axis")
CORA_TENSOR_OP(any, derived, not_differentiable, exact, 0, "1 if some entry along an axis is nonzero")
CORA_TENSOR_OP(all, derived, not_differentiable, exact, 0, "1 if every entry along an axis is nonzero")
CORA_TENSOR_OP(count_nonzero, derived, not_differentiable, exact, 0, "the number of nonzero entries along an axis")
CORA_TENSOR_OP(softmax, derived, differentiable, ulp, 8, "e^x / sum(e^x) along an axis, shifted by the max")
// Shape and Selection -----------------------------------------------------------------------------
CORA_TENSOR_OP(reshape, core, differentiable, exact, 0, "the same values in another shape (row-major)")
CORA_TENSOR_OP(permute_dims, core, differentiable, exact, 0, "the axes in another order")
CORA_TENSOR_OP(broadcast_to, core, differentiable, exact, 0, "repeated along axes of size 1 or new leading axes (torch expand)")
CORA_TENSOR_OP(slice, core, differentiable, exact, 0, "x[..., start:stop:step, ...] along one axis")
CORA_TENSOR_OP(take, core, differentiable, exact, 0, "the entries at the given indices along an axis")
CORA_TENSOR_OP(take_along_axis, core, differentiable, exact, 0, "per position, the entry at the index of the same position")
CORA_TENSOR_OP(concat, core, differentiable, exact, 0, "tensors joined along an axis")
CORA_TENSOR_OP(matrix_transpose, derived, differentiable, exact, 0, "the last two axes swapped")
CORA_TENSOR_OP(expand_dims, derived, differentiable, exact, 0, "a new axis of size 1")
CORA_TENSOR_OP(squeeze, derived, differentiable, exact, 0, "an axis of size 1 removed")
CORA_TENSOR_OP(stack, derived, differentiable, exact, 0, "tensors of one shape along a new axis")
CORA_TENSOR_OP(flip, derived, differentiable, exact, 0, "the order along an axis reversed")
CORA_TENSOR_OP(tile, derived, differentiable, exact, 0, "copies side by side along each axis (MATLAB repmat)")
CORA_TENSOR_OP(diag, derived, differentiable, exact, 0, "a column (..., n, 1) as the diagonal matrix (..., n, n)")
CORA_TENSOR_OP(diagonal, derived, differentiable, exact, 0, "the diagonal of (..., n, m) as a column (..., min(n, m), 1)")
CORA_TENSOR_OP(tril, derived, differentiable, exact, 0, "the entries on and below a diagonal, the rest zero")
CORA_TENSOR_OP(triu, derived, differentiable, exact, 0, "the entries on and above a diagonal, the rest zero")
CORA_TENSOR_OP(block_diag, derived, differentiable, exact, 0, "matrices along the diagonal of one, zeros elsewhere (MATLAB blkdiag)")
// Sorting -----------------------------------------------------------------------------------------
CORA_TENSOR_OP(argsort, core, not_differentiable, exact, 0, "the indices that sort along an axis, stable")
CORA_TENSOR_OP(sort, derived, piecewise, exact, 0, "the values sorted along an axis")
CORA_TENSOR_OP(topk, derived, piecewise, exact, 0, "the k largest (or smallest) along an axis and their indices, stable")
CORA_TENSOR_OP(nonzero, derived, not_differentiable, exact, 0, "the flat indices of the nonzero entries, on the host (MATLAB find)")
// Linear Algebra ----------------------------------------------------------------------------------
CORA_TENSOR_OP(matmul, core, differentiable, sum, 2, "the matrix product, batched and broadcast (lean: sums nested to the right)")
CORA_TENSOR_OP(solve, core, differentiable, norm, 64, "x with A x = B, batched")
CORA_TENSOR_OP(cholesky, core, differentiable, norm, 64, "the lower factor L of A = L L^T")
CORA_TENSOR_OP(qr, core, differentiable, norm, 64, "the reduced Q R, R with a nonnegative diagonal")
CORA_TENSOR_OP(svd, core, differentiable, norm, 64, "the reduced U S V^T, S a column, descending, signs fixed")
CORA_TENSOR_OP(eigh, core, differentiable, norm, 64, "eigenvalues (ascending column) and vectors of a symmetric matrix, signs fixed")
CORA_TENSOR_OP(inv, derived, differentiable, norm, 64, "the inverse, by solve with the identity")
CORA_TENSOR_OP(lstsq, derived, differentiable, norm, 64, "the least-squares solution of A x = B (full column rank), by qr")
CORA_TENSOR_OP(pinv, derived, differentiable, norm, 64, "the pseudo-inverse, by svd")
CORA_TENSOR_OP(matrix_rank, derived, not_differentiable, exact, 0, "the number of singular values above a tolerance")
CORA_TENSOR_OP(trace, derived, differentiable, sum, 1, "the sum of the diagonal, (..., 1, 1)")
CORA_TENSOR_OP(kron, derived, differentiable, exact, 0, "the Kronecker product")
CORA_TENSOR_OP(expm, derived, differentiable, norm, 256, "the matrix exponential (Pade 13, scaling and squaring)")
CORA_TENSOR_OP(matrix_norm, derived, piecewise, sum, 2, "the 1, 2, inf or Frobenius norm of (..., n, m), (..., 1, 1)")
CORA_TENSOR_OP(vector_norm, derived, piecewise, sum, 2, "the 1, 2 or inf norm along an axis")
// Fused Primitives --------------------------------------------------------------------------------
CORA_TENSOR_OP(zonotope_linear_map, fused, differentiable, sum, 2, "M c and M G of a zonotope in one call")
CORA_TENSOR_OP(zonotope_interval_map, fused, piecewise, sum, 2, "T c and [T G, diag(R (|c| + sum|G|))] for the interval matrix [inf, sup], T its stored center and R the larger of |inf - T| and |sup - T| (CORALean's mtimesIntervalMat)")
CORA_TENSOR_OP(zonotope_linear_combination, fused, differentiable, exact, 0, "(c1 + c2)/2 and [(G1 + G2)/2, (G1 - G2)/2, (c1 - c2)/2] (CORA's linComb)")
CORA_TENSOR_OP(interval_matmul, fused, piecewise, sum, 2, "the bounds of I M for an interval matrix I (CORA's mtimes)")
CORA_TENSOR_OP(matmul_interval, fused, piecewise, sum, 2, "the bounds of M I for an interval matrix I (CORA's mtimes)")
CORA_TENSOR_OP(girard_split, fused, not_differentiable, exact, 0, "the generators by Girard's score |g|_1 - |g|_inf, the k kept and the rest")
CORA_TENSOR_OP(abs_sum, fused, piecewise, sum, 1, "sum(|x|) along the last axis, kept (the radius of a zonotope)")
