// errors - the table of cora::Error identifiers: C++ name, CORA's identifier, what it means
//
// One row per identifier: CORA_ERROR(name, identifier, meaning), in the order of CORA's CORAerror.
// error.h turns the rows into the enum Error::Id, error.cpp into the table of names.
//
// the identifiers of CORA's error messages (global/functions/helper/.../CORAerror.m)
CORA_ERROR(wrong_input_in_constructor, "CORA:wrongInputInConstructor", "a constructor got arguments it cannot build from")
CORA_ERROR(no_input_in_set_constructor, "CORA:noInputInSetConstructor", "a set constructor got no arguments")
CORA_ERROR(dimension_mismatch, "CORA:dimensionMismatch", "operands of different dimensions or sizes")
CORA_ERROR(empty_set, "CORA:emptySet", "the operation is not defined for an empty set")
CORA_ERROR(converter_issue, "CORA:converterIssue", "a conversion between formats failed")
CORA_ERROR(config_file, "CORA:configFile", "a configuration file could not be written")
CORA_ERROR(file_not_found, "CORA:fileNotFound", "a file does not exist")
CORA_ERROR(wrong_value, "CORA:wrongValue", "an argument has a value outside its admissible range")
CORA_ERROR(no_exact_alg, "CORA:noExactAlg", "there is no exact algorithm for these operands")
CORA_ERROR(no_specific_alg, "CORA:noSpecificAlg", "the requested algorithm is not implemented for them")
CORA_ERROR(solver_issue, "CORA:solverIssue", "a solver failed")
CORA_ERROR(no_suitable_solver, "CORA:noSuitableSolver", "no solver for the problem is available")
CORA_ERROR(not_converged, "CORA:notConverged", "an iteration did not converge")
CORA_ERROR(empty_property, "CORA:emptyProperty", "a property that is needed is empty")
CORA_ERROR(wrong_field_value, "CORA:wrongFieldValue", "an option has a value outside its admissible ones")
CORA_ERROR(plot_properties, "CORA:plotProperties", "a plot got wrong dimensions or properties")
CORA_ERROR(even_number_input_args, "CORA:evenNumberInputArgs", "name-value pairs: an even number expected")
CORA_ERROR(odd_number_input_args, "CORA:oddNumberInputArgs", "name-value pairs: an odd number expected")
CORA_ERROR(num_input_args_constructor, "CORA:numInputArgsConstructor", "a constructor got the wrong number of arguments")
CORA_ERROR(redundant_name_value_pair, "CORA:redundantNameValuePair", "an option name that is not one of the known ones")
// further identifiers of CORAerror
CORA_ERROR(degenerate_set, "CORA:degenerateSet", "the operation needs a full-dimensional set")
CORA_ERROR(yalmip, "CORA:YALMIP", "(MATLAB CORA: YALMIP) kept for the numbering")
CORA_ERROR(out_of_domain, "CORA:outOfDomain", "a value lies outside the domain of a function")
CORA_ERROR(special_error, "CORA:specialError", "a specific situation described by the message")
CORA_ERROR(not_supported, "CORA:notSupported", "the combination of arguments is not supported")
CORA_ERROR(not_defined, "CORA:notDefined", "the operation is not defined for these arguments")
CORA_ERROR(nn_layer_not_supported, "CORA:nnLayerNotSupported", "a neural network layer is not supported")
CORA_ERROR(reach_set_explosion, "CORA:reachSetExplosion", "the reachable sets grew without bound")
CORA_ERROR(out_of_memory, "CORA:outOfMemory", "the computation needs more memory than there is")
CORA_ERROR(noops, "CORA:noops", "no implementation for this pair of classes")
CORA_ERROR(install, "CORA:install", "a dependency is missing from the installation")
CORA_ERROR(report_to_dev, "CORA:reportToDev", "an internal inconsistency: please report it")
