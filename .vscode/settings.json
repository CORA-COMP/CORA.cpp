{
    "python.defaultInterpreterPath": "${env:HOME}/miniforge3/envs/coracpp/bin/python",
    "python.analysis.extraPaths": ["${env:HOME}/.cache/coracpp/build"],
    "python.testing.unittestEnabled": true,
    "python.testing.unittestArgs": ["-v", "-s", "tests/python", "-p", "test_*.py"],
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${env:HOME}/.cache/coracpp/build",
        "LD_LIBRARY_PATH": "${env:HOME}/miniforge3/envs/coracpp/lib"
    },
    "C_Cpp.default.configurationProvider": "",
    "C_Cpp.clang_format_path": "${env:HOME}/miniforge3/envs/coracpp/bin/clang-format",
    "editor.formatOnSave": false,
    "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
    "files.associations": { "*.h": "cpp", "*.tpp": "cpp" }
}
