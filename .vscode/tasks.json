{
    // The paths come from .vscode/settings.json, written by scripts/setup_local.sh.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run example (C++)",
            "type": "shell",
            "command": "scripts/with_env.sh python scripts/run_example.py ${file}",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build example (debug)",
            "type": "shell",
            "command": "scripts/with_env.sh scripts/build.sh --debug ${fileBasenameNoExtension}",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build python package",
            "type": "shell",
            "command": "scripts/with_env.sh scripts/build.sh python",
            "problemMatcher": "$gcc"
        },
        {
            "label": "run example (Python)",
            "type": "shell",
            "command": "scripts/with_env.sh python ${file}",
            "dependsOn": "build python package",
            "problemMatcher": []
        },
        {
            "label": "test (conventions and C++)",
            "type": "shell",
            "command": "scripts/with_env.sh scripts/build.sh && scripts/with_env.sh scripts/test.sh -j4 -LE python",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "test (python)",
            "type": "shell",
            "command": "scripts/with_env.sh python -m unittest discover -s tests/python",
            "dependsOn": "build python package",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "conventions",
            "type": "shell",
            "command": "scripts/with_env.sh python tests/global/test_codingConventions.py",
            "problemMatcher": []
        }
    ]
}
