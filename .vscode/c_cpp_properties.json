{
    "version": 4,
    "configurations": [
        {
            "name": "coracpp (conda env, libtorch)",
            "compilerPath": "${env:HOME}/miniforge3/envs/coracpp/bin/x86_64-conda-linux-gnu-c++",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "defines": ["CORACPP_TORCH"],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/tests",
                "${env:HOME}/miniforge3/envs/coracpp/include/eigen3",
                "${env:HOME}/miniforge3/envs/coracpp/include",
                "${env:HOME}/miniforge3/envs/coracpp/lib/python3.12/site-packages/torch/include",
                "${env:HOME}/miniforge3/envs/coracpp/lib/python3.12/site-packages/torch/include/torch/csrc/api/include"
            ]
        }
    ]
}
